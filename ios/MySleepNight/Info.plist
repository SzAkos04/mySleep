<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- recording with the screen locked: the reason this app exists -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- the night logs show up in the Files app, and devicectl can copy them to the Mac -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- the alarm is the system's (AlarmKit): it rings on the lock screen, through silent mode -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSAlarmKitUsageDescription</key>
	<string>mySleep Night rings your alarm, at your wake time or earlier when you stir.</string>
</dict>
</plist>
