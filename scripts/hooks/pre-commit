#!/bin/sh
# Test-driven: nothing is committed while a test or the build fails (scripts/test.sh).
# Enabled per clone with: git config core.hooksPath scripts/hooks
# The tests run on the working tree, so it must be what is committed: a change left unstaged, or a
# new file not added, would pass here and be missing from the commit (it happened once).
cd "$(git rev-parse --show-toplevel)"
if ! git diff --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
  echo "pre-commit: the working tree is not what is being committed; stage or stash these first:" >&2
  git status --short | grep -v '^[MADR] ' >&2
  exit 1
fi
exec scripts/test.sh
