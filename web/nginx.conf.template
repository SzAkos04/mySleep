# Rendered at start from NGINX_PORT, BACKEND and PORT (nginx image's envsubst).
server {
    listen ${NGINX_PORT};
    root /usr/share/nginx/html;
    index index.html;
    absolute_redirect off;

    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;

    location ^~ /api/ {
        client_max_body_size 4m;
        # resolved per request, so a recreated api container (new IP) does not mean 502s
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $api http://${BACKEND}:${PORT};
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # hashed build files never change
    location ^~ /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # the shell, the worker and the manifest: always revalidate, so a deploy shows at once
    location / {
        add_header Cache-Control "no-cache";
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        try_files $uri /index.html;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_min_length 1024;
}
